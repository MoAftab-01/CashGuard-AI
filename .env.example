# Defaults are local-only. This file is documentation, not automatically loaded.
CASHGUARD_API_HOST=127.0.0.1
CASHGUARD_API_PORT=8000
CASHGUARD_CONTAINER_BIND=false
CASHGUARD_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
CASHGUARD_MAX_REQUEST_BYTES=1048576
CASHGUARD_BODY_TIMEOUT_SECONDS=10
CASHGUARD_MAX_CONCURRENT_ANALYTICS=2
CASHGUARD_METRICS_ENABLED=true
CASHGUARD_LOG_LEVEL=INFO
CASHGUARD_API_URL=http://127.0.0.1:8000
CASHGUARD_CLIENT_TIMEOUT_SECONDS=30
CASHGUARD_OLLAMA_URL=http://127.0.0.1:11434
CASHGUARD_OLLAMA_MODEL=gemma3:4b
CASHGUARD_OLLAMA_TIMEOUT=90
MLFLOW_DISABLE_TELEMETRY=true
# Optional Compose published-port overrides; keep localhost bindings in compose.yaml.
CASHGUARD_DASHBOARD_PORT=8501
CASHGUARD_MLFLOW_PORT=5000
